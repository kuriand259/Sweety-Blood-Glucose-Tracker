generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Slot {
  MORNING_FASTING
  AFTER_BREAKFAST
  AFTER_LUNCH
  AFTER_DINNER
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  readings     Reading[]
}

model Reading {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime @db.Date
  slot      Slot
  value     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date, slot])
  @@index([userId, date])
}
